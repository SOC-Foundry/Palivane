# Copy to `.env` (next to docker-compose.yml) and edit. Compose reads `.env` automatically.

# Web port on the host (open http://localhost:<WEB_PORT>).
WEB_PORT=8080

# Postgres credentials (used by the db service and the app's DATABASE_URL).
POSTGRES_USER=palivane
POSTGRES_PASSWORD=palivane
POSTGRES_DB=palivane

# REQUIRED — signs auth tokens. The stack refuses to boot on Postgres with a weak/unset
# key (JWTs would be forgeable). Generate a real one: openssl rand -hex 32
PALIVANE_SECRET_KEY=

# Allowed browser origin (must match how you reach the web app).
CORS_ORIGINS=http://localhost:8080

# Seed a demo tenant + admin + sample findings on first boot (off by default — a seeded
# admin with a known password is a foothold; enable only for a throwaway demo).
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=changeme123

# Self-serve org signup. Set false to lock down: only users an admin adds can sign in
# (the login screen hides org creation). Recommended for a single-org deployment: with it
# on, anyone who can reach the console can create an org on this database and be its admin.
PALIVANE_ALLOW_SIGNUP=true

# Optional: Prometheus scrape token. /metrics answers 404 until it is set; scrape with
# `Authorization: Bearer <token>` (or ?token=). Generate with: openssl rand -hex 32
# PALIVANE_METRICS_TOKEN=

# Optional: enable the LLM judge with an API key. JUDGE_PROVIDER=auto picks whichever
# key is set (anthropic > openai > gemini); force anthropic|openai|gemini, or none to
# disable. (JUDGE_PROVIDER=claude-cli — verdicts via a signed-in Claude Code CLI on a
# subscription — is DEPRECATED: Anthropic's ToS, enforced 2026-04-04, restrict
# subscription auth to Anthropic's own products. It still runs with a warning but will
# be removed; migrate to an API key.)
# ANTHROPIC_API_KEY=sk-ant-...    # Claude backend
# OPENAI_API_KEY=sk-...           # GPT backend
# GEMINI_API_KEY=...              # Gemini backend
# JUDGE_MODEL=                    # blank = per-provider default

# LLM gateway (Module B). enforce=block risky prompts inline; else monitor-only.
GATEWAY_ENFORCE=false
GATEWAY_BLOCK_SEVERITY=high
# Same choice for the local capture planes (CLI hooks, desktop proxy): the stance a device
# gets when it has no local flag and the org has not set one in Settings. Keep it in step
# with GATEWAY_ENFORCE. Confirmed secret/PII leaks block in either mode.
CLIENT_ENFORCE=false
# Image DLP: OCR images in gateway requests (screenshots carry keys too) and images the
# Slack/Drive/S3 connectors find. Local tesseract, never a cloud vision API. Off by default;
# the Docker image ships tesseract, so true is all it takes. Each request's OCR is capped
# (4 images, 5 MB / 16 MP each, 5 s per image, 10 s in all); an image not read marks the
# verdict "partly scanned" and is never a reason to block.
PALIVANE_OCR=false
# Forward allowed calls to an OpenAI-compatible upstream (empty = stub reply).
# GATEWAY_UPSTREAM_BASE=https://api.openai.com/v1
# GATEWAY_UPSTREAM_KEY=sk-...
# Anthropic (/v1/messages) and Gemini (/v1beta/.../generateContent) upstreams.
# GATEWAY_ANTHROPIC_KEY=sk-ant-...    # or ANTHROPIC_API_KEY
# GATEWAY_GEMINI_KEY=...              # or GEMINI_API_KEY

# Browser extension (Module C shadow-AI capture). Shared token the extension presents
# to /api/ingest/ai-usage; findings attributed to INGEST_TENANT.
# EXTENSION_INGEST_TOKEN=a-long-random-string
# INGEST_TENANT=demo

# MCP inspection (agentic tool-use via the egress proxy). enforce=block risky tool calls.
# MCP_ENFORCE=false
# MCP_BLOCK_SEVERITY=high
# MCP_ALLOWED_SERVERS=mcp.githubcopilot.com,mcp.acme.com   # empty = don't flag on server identity
