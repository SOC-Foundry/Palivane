#!/usr/bin/env python3
"""warden-secrets — endpoint credential-hygiene scan (secrets at rest).

Infostealers harvest credentials that are already sitting on the machine — SSH/RSA keys,
`~/.aws/credentials`, `.git-credentials`, `.env` files, CI tokens in shell history. This
scanner finds them *before* a stealer does and reports them to Warden as
`credential_at_rest` findings.

Privacy by design — detection runs **locally** and only METADATA leaves the box: the
secret *type*, file path, line, a masked preview (`ghp_••••4f2a`), and whether the file is
world/group-readable. The raw secret never leaves the device, so Warden never becomes the
exfil path. Reports to POST /api/scan/secrets.

    warden-secrets                 # scan well-known locations + dev roots, report to Warden
    warden-secrets --dry-run       # print what would be reported; send nothing
    warden-secrets --root ~/work   # add an extra directory to the .env sweep
    warden-secrets --engine trufflehog   # drive TruffleHog (~800 detectors + live verify)
    warden-secrets --engine gitleaks     # drive Gitleaks instead of the built-in patterns

With --engine, Warden runs the external scanner if it's on PATH, masks its findings
locally (raw secrets never leave), and feeds the same pipeline; falls back to the built-in
regex scan if the tool isn't installed. For CI, pipe a scanner's JSON to `warden-import`.

Config: WARDEN_URL + WARDEN_TOKEN (an ak_… key) from the environment, else the gateway
pair in ~/.claude/settings.json / ~/.cursor/warden.json. Stdlib only.
"""

from __future__ import annotations

import json
import math
import os
import re
import shutil
import stat
import subprocess
import sys
import urllib.request
from collections import Counter

# --- Secret patterns (mirrors backend patterns.py labels so the server scores by type) ---
# Canonical formats (separator present) + separator-STRIPPED evasion variants: a key whose
# dash/underscore was deleted to dodge DLP is caught and labeled "(separator stripped —
# likely bypass)". OpenAI/Anthropic keep a distinctive sub-marker in the stripped form; a
# bare de-dashed `sk` would match words, so that case is left to server-side entropy.
_STRIP = " (separator stripped — likely bypass)"
_PATTERNS = [
    ("Private key block", re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")),
    ("AWS access key id", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("GitHub token", re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}")),
    ("GitHub fine-grained PAT", re.compile(r"github_pat_[A-Za-z0-9_]{22,}")),
    ("GitLab PAT", re.compile(r"glpat-[A-Za-z0-9_\-]{20,}")),
    ("Slack token", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("Google API key", re.compile(r"AIza[0-9A-Za-z_\-]{30,}")),
    ("Google OAuth token", re.compile(r"ya29\.[0-9A-Za-z_\-]{20,}")),
    ("OpenAI API key", re.compile(r"sk-[a-zA-Z0-9]{16,}")),
    # Modern OpenAI keys carry a dashed sub-marker (sk-proj-/sk-svcacct-/sk-admin-) that the
    # generic sk- above misses (the dash breaks its [a-zA-Z0-9] run).
    ("OpenAI API key", re.compile(r"sk-(?:proj|svcacct|admin)-[A-Za-z0-9_\-]{20,}")),
    ("Anthropic API key", re.compile(r"sk-ant-[a-zA-Z0-9_\-]{16,}")),
    ("Stripe secret key", re.compile(r"\b[rs]k_(live|test)_[0-9a-zA-Z]{16,}")),
    ("npm token", re.compile(r"npm_[A-Za-z0-9]{36}")),
    ("PyPI token", re.compile(r"pypi-[A-Za-z0-9_\-]{16,}")),
    ("Slack webhook", re.compile(r"https://hooks\.slack\.com/services/[A-Za-z0-9/]{20,}")),
    ("Slack app token", re.compile(r"xapp-[0-9]-[A-Za-z0-9-]{10,}")),
    ("JWT", re.compile(r"\beyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{6,}")),
    # More providers with distinctive, low-false-positive prefixes.
    ("SendGrid API key", re.compile(r"SG\.[A-Za-z0-9_\-]{16,}\.[A-Za-z0-9_\-]{16,}")),
    ("Twilio API key SID", re.compile(r"\bSK[0-9a-fA-F]{32}\b")),
    ("Square access token", re.compile(r"sq0(csp|atp)-[A-Za-z0-9_\-]{22,}")),
    ("Mailgun API key", re.compile(r"\bkey-[0-9a-f]{32}\b")),
    ("DigitalOcean token", re.compile(r"dop_v1_[a-f0-9]{64}")),
    ("Doppler token", re.compile(r"dp\.(?:pt|st|ct|sa|scim|audit)\.[A-Za-z0-9]{40,}")),
    ("HashiCorp Vault token", re.compile(r"\bhvs\.[A-Za-z0-9_\-]{24,}")),
    ("Grafana service account token", re.compile(r"glsa_[A-Za-z0-9]{32}_[0-9a-fA-F]{8}")),
    ("Terraform Cloud token", re.compile(r"[A-Za-z0-9]{14}\.atlasv1\.[A-Za-z0-9_\-]{60,}")),
    ("Databricks token", re.compile(r"\bdapi[0-9a-f]{32}\b")),
    ("Notion integration token", re.compile(r"\bntn_[A-Za-z0-9]{40,}")),
    # evasion — separator stripped
    ("OpenAI API key" + _STRIP, re.compile(r"sk(proj|svcacct|admin)[A-Za-z0-9]{20,}")),
    ("Anthropic API key" + _STRIP, re.compile(r"skant[A-Za-z0-9]{16,}")),
    ("GitHub token" + _STRIP, re.compile(r"gh[pousr][A-Za-z0-9]{30,}")),
    ("GitHub fine-grained PAT" + _STRIP, re.compile(r"github_pat[A-Za-z0-9]{22,}")),
    ("GitLab PAT" + _STRIP, re.compile(r"glpat[A-Za-z0-9]{20,}")),
    ("Slack token" + _STRIP, re.compile(r"xox[baprs][A-Za-z0-9]{10,}")),
    ("Stripe secret key" + _STRIP, re.compile(r"\b[rs]k(live|test)[0-9a-zA-Z]{16,}")),
    ("npm token" + _STRIP, re.compile(r"npm[A-Za-z0-9]{36}")),
    ("PyPI token" + _STRIP, re.compile(r"pypi[A-Za-z0-9]{32,}")),
]
# Only trust a generic key=value credential in files that are meant to hold config/secrets.
_ASSIGN_RE = re.compile(
    r"""(?i)\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|
        private[_-]?key|client[_-]?secret)\b\s*[:=]\s*['"]?([^\s'"]{8,})""", re.VERBOSE)

# Credentials embedded in a connection URL (postgres://user:pass@host, mongodb+srv://…,
# redis://…) — the password sits inside the URL, so the key=value rule above misses it.
_CONN_RE = re.compile(
    r"\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\+srv)?|redis|rediss|amqps?|mssql|"
    r"clickhouse|cockroachdb|ftp)://[^\s:/@]+:([^\s:/@]{3,})@[^\s/]+", re.IGNORECASE)

# Values that are placeholders/templates, not real secrets — keeps .env.example, docs, and
# ${VAR}/$VAR interpolation from false-positiving on the assignment + connection-URL rules.
_PLACEHOLDER_RE = re.compile(
    r"(?i)^(?:x{3,}|\*{3,}|\.{3,}|changeme|change_me|placeholder|example|sample|dummy|fake|"
    r"redacted|your[_-]?\w+|my[_-]?\w+|test|password|passwd|pass|secret|token|<[^>]+>|"
    r"\$?\{[^}]+\}|\$[a-z_][a-z0-9_]*|%[a-z_]+%)$")

# Tier-2 generic secret heuristic: a long, high-entropy token with no recognized prefix
# (novel/vendor keys). Mirrors the backend (patterns.find_high_entropy_tokens) — 24–80 chars
# of [A-Za-z0-9_], ≥2 character classes, Shannon entropy ≥ 3.6, and not a plain hex digest
# (git SHAs / md5). Reported under the label the server already knows for entropy findings.
_ENTROPY_LABEL = "Possible secret (high-entropy token)"
_TOKEN_CANDIDATE_RE = re.compile(r"[A-Za-z0-9_]{24,80}")
_HEX_RE = re.compile(r"^[0-9a-fA-F]+$")
_MIN_ENTROPY = 3.6


def _is_placeholder(value: str) -> bool:
    return bool(_PLACEHOLDER_RE.match((value or "").strip()))


def _shannon_entropy(s: str) -> float:
    n = len(s)
    if n == 0:
        return 0.0
    return -sum((c / n) * math.log2(c / n) for c in Counter(s).values())


def _entropy_tokens(line: str) -> list[str]:
    """High-entropy token candidates in the *value* part of a line (after the first `=`/`:`,
    where a credential actually sits) — scoping to values keeps prose/code false positives low."""
    sep = min((i for i in (line.find("="), line.find(":")) if i >= 0), default=-1)
    if sep < 0:
        return []
    out = []
    for m in _TOKEN_CANDIDATE_RE.finditer(line[sep + 1:]):
        tok = m.group(0)
        if _HEX_RE.match(tok):
            continue
        classes = (any(c.islower() for c in tok) + any(c.isupper() for c in tok)
                   + any(c.isdigit() for c in tok))
        if classes >= 2 and _shannon_entropy(tok) >= _MIN_ENTROPY:
            out.append(tok)
    return out

# --- Where credentials actually live -----------------------------------------------------
# Well-known credential files (~-relative). Globs allowed.
_TARGET_GLOBS = [
    "~/.ssh/id_*", "~/.ssh/*.pem", "~/.ssh/*.key",
    "~/.aws/credentials",
    "~/.config/gh/hosts.yml", "~/.config/gh/hosts.yaml",
    "~/.git-credentials",
    "~/.npmrc", "~/.pypirc", "~/.netrc",
    "~/.docker/config.json",
    "~/.kube/config",
    # cloud service-account keys / tokens — crown jewels for lateral movement
    "~/.config/gcloud/application_default_credentials.json",
    "~/.config/gcloud/legacy_credentials/*/adc.json",
    "~/.azure/accessTokens.json", "~/.azure/azureProfile.json",
    # database + vault credentials
    "~/.pgpass", "~/.my.cnf", "~/.mylogin.cnf",
    "~/.vault_pass", "~/.vault-password", "~/.ansible_vault_password",
    "~/.bash_history", "~/.zsh_history",
]
# Dev/data roots swept (bounded). Add more via WARDEN_SECRETS_ROOTS (e.g. server paths
# /etc:/opt:/srv) or --root; Desktop/Documents catch exported keys people leave lying around.
_DEFAULT_ROOTS = ["~/src", "~/code", "~/projects", "~/dev", "~/repos", "~/work",
                  "~/Desktop", "~/Documents", "."]
_PRUNE = {"node_modules", ".git", ".venv", "venv", "dist", "build", "__pycache__", ".next",
          ".cache", "target", "vendor"}
_MAX_BYTES = 1_000_000       # skip files bigger than 1 MB (not credential stores)
_MAX_DEPTH = 4
_PRIVKEY_NAMES = ("id_rsa", "id_ed25519", "id_ecdsa", "id_dsa")
# Binary keystores — private by definition, so flag them by extension (content scan can't
# read the binary). .pem/.key stay content-scanned (a public cert has no PRIVATE KEY header).
_PRIVKEY_EXTS = (".p12", ".pfx", ".pkcs12", ".ppk")
# Filenames/extensions in a repo that routinely carry secrets — content-scanned in the sweep.
_CONFIG_NAMES = {"settings.py", "config.py", "secrets.py", "config.yml", "config.yaml",
                 "secrets.yml", "secrets.yaml", "appsettings.json", "application.properties",
                 "application.yml", "application.yaml", "wp-config.php", "config.php",
                 "database.yml", "docker-compose.yml", "docker-compose.yaml", "credentials"}
_SECRET_EXTS = (".pem", ".key", ".p12", ".pfx", ".pkcs12", ".ppk", ".tfstate", ".tfstate.backup")


def _sweep_match(fn: str) -> bool:
    """Should this file in a dev/data root be content-scanned? .env-style, known config
    files, key/cert material, Terraform state, and cloud service-account JSON."""
    low = fn.lower()
    if fn == ".env" or fn.startswith(".env.") or fn.endswith(".env"):
        return True
    if low in _CONFIG_NAMES or low.endswith(_SECRET_EXTS):
        return True
    if low.endswith(".json") and ("service-account" in low or "serviceaccount" in low):
        return True
    return False


def _sweep_roots(extra: list[str]) -> list[str]:
    """Default roots + WARDEN_SECRETS_ROOTS (os.pathsep- or comma-separated) + --root."""
    env = os.getenv("WARDEN_SECRETS_ROOTS", "").replace(",", os.pathsep)
    env_roots = [r for r in env.split(os.pathsep) if r.strip()]
    seen, out = set(), []
    for r in _DEFAULT_ROOTS + env_roots + extra:
        if r not in seen:
            seen.add(r); out.append(r)
    return out


def mask(secret: str) -> str:
    s = secret.strip()
    if len(s) <= 8:
        return "••••"
    return f"{s[:4]}••••{s[-4:]}"


def scan_text(text: str) -> list[tuple[str, int, str]]:
    """Return (secret_type, line_no, masked_preview) for each credential in `text` —
    known-provider patterns, connection-URL credentials, labeled key=value assignments, and
    a tier-2 high-entropy heuristic for novel/vendor tokens with no recognized prefix."""
    found: list[tuple[str, int, str]] = []
    seen: set[tuple[str, str]] = set()
    for lineno, line in enumerate(text.splitlines(), 1):
        if len(line) > 4000:
            line = line[:4000]
        matched: set[str] = set()   # raw secrets found on this line — suppress entropy dupes
        for label, rx in _PATTERNS:
            m = rx.search(line)
            if m and (label, m.group(0)) not in seen:
                seen.add((label, m.group(0)))
                matched.add(m.group(0))
                found.append((label, lineno, mask(m.group(0))))
        cm = _CONN_RE.search(line)
        if cm and not _is_placeholder(cm.group(1)) and ("Connection string credential", cm.group(1)) not in seen:
            seen.add(("Connection string credential", cm.group(1)))
            matched.add(cm.group(1))
            found.append(("Connection string credential", lineno, mask(cm.group(1))))
        am = _ASSIGN_RE.search(line)
        if am and not _is_placeholder(am.group(1)) and ("Credential assignment", am.group(1)) not in seen:
            seen.add(("Credential assignment", am.group(1)))
            matched.add(am.group(1))
            found.append(("Credential assignment", lineno, mask(am.group(1))))
        for tok in _entropy_tokens(line):
            # Don't re-flag a token a specific pattern already caught (as its type).
            if any(tok in mv or mv in tok for mv in matched):
                continue
            if (_ENTROPY_LABEL, tok) not in seen:
                seen.add((_ENTROPY_LABEL, tok))
                found.append((_ENTROPY_LABEL, lineno, mask(tok)))
    return found


def world_readable(path: str) -> bool:
    try:
        return bool(os.stat(path).st_mode & (stat.S_IRGRP | stat.S_IROTH))
    except OSError:
        return False


def _read(path: str) -> str | None:
    try:
        if os.path.getsize(path) > _MAX_BYTES:
            return None
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read()
    except (OSError, ValueError):
        return None


def scan_file(path: str) -> dict | None:
    """Scan one file; return a report dict (metadata only) or None if clean/unreadable."""
    # Binary keystores are private by definition — flag by extension (content is unreadable).
    if os.path.splitext(path)[1].lower() in _PRIVKEY_EXTS:
        return {"path": path, "secret_types": ["Private key block"], "masked": "••••",
                "line": 1, "world_readable": world_readable(path)}
    text = _read(path)
    if text is None:
        return None
    hits = scan_text(text)
    # A private-key *file* by name is a finding even if the header regex is oddly formatted.
    base = os.path.basename(path)
    if not hits and base in _PRIVKEY_NAMES and "PRIVATE KEY" in text:
        hits = [("Private key block", 1, "••••")]
    if not hits:
        return None
    types = list(dict.fromkeys(t for t, _, _ in hits))
    first = hits[0]
    return {"path": path, "secret_types": types, "masked": first[2], "line": first[1],
            "world_readable": world_readable(path)}


def iter_target_files(extra_roots: list[str]) -> list[str]:
    """All candidate files: well-known credential paths + a bounded sweep of dev/data roots
    for .env-style, config, key/cert, Terraform-state, and service-account files."""
    import glob
    paths: list[str] = []
    for g in _TARGET_GLOBS:
        paths.extend(glob.glob(os.path.expanduser(g)))
    for root in _sweep_roots(extra_roots):
        base = os.path.expanduser(root)
        if not os.path.isdir(base):
            continue
        base_depth = base.rstrip(os.sep).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(base):
            if dirpath.count(os.sep) - base_depth >= _MAX_DEPTH:
                dirnames[:] = []
            dirnames[:] = [d for d in dirnames if d not in _PRUNE and not d.startswith(".")
                           or d == ".config"]
            for fn in filenames:
                if _sweep_match(fn):
                    paths.append(os.path.join(dirpath, fn))
    # De-dup, keep only regular files.
    seen, out = set(), []
    for p in paths:
        rp = os.path.realpath(p)
        if rp not in seen and os.path.isfile(p):
            seen.add(rp)
            out.append(p)
    return out


def _settings_env(path: str) -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            data = json.load(f)
        env = data.get("env") if isinstance(data, dict) else None
        return env if isinstance(env, dict) else (data if isinstance(data, dict) else {})
    except Exception:
        return {}


def read_config() -> dict:
    url = os.getenv("WARDEN_URL", "")
    token = os.getenv("WARDEN_TOKEN", "")
    if not url or not token:
        claude = _settings_env("~/.claude/settings.json")
        cursor = _settings_env("~/.cursor/warden.json")
        token = token or claude.get("WARDEN_TOKEN", "") or cursor.get("token", "")
        if not token:
            gw = claude.get("ANTHROPIC_AUTH_TOKEN", "")
            if isinstance(gw, str) and gw.startswith("ak_"):
                token = gw
        if not url:
            url = claude.get("WARDEN_URL", "") or cursor.get("url", "")
            if not url:
                base = claude.get("ANTHROPIC_BASE_URL", "")
                if isinstance(base, str) and base:
                    url = base[:-3] if base.rstrip("/").endswith("/v1") else base
    return {"url": url.rstrip("/"), "token": token}


def post_batch(cfg: dict, items: list[dict], host: str, timeout: float = 15.0) -> dict | None:
    try:
        req = urllib.request.Request(
            cfg["url"] + "/api/scan/secrets", method="POST",
            data=json.dumps({"items": items, "host": host, "record": True}).encode(),
            headers={"content-type": "application/json", "User-Agent": "warden-secrets/1.0", "X-Warden-Token": cfg["token"]})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception as e:
        print(f"  (report failed: {e})", file=sys.stderr)
        return None


# --- Optional external engines (TruffleHog / Gitleaks) --------------------------------
# When requested, drive a heavier scanner locally and normalize + MASK its output here, so
# only metadata leaves (same privacy contract as the built-in scan). TruffleHog additionally
# *verifies* whether a credential is live. Falls back to the built-in scan if not installed.
_TH_MAP = {"Github": "GitHub token", "GitHub": "GitHub token", "AWS": "AWS access key id",
           "GitLab": "GitLab PAT", "PrivateKey": "Private key block", "OpenAI": "OpenAI API key",
           "Anthropic": "Anthropic API key", "SlackWebhook": "Slack webhook",
           "Slack": "Slack token", "StripeApiKey": "Stripe secret key",
           "NpmToken": "npm token", "PyPI": "PyPI token"}
_GL_MAP = {"github-pat": "GitHub token", "aws-access-token": "AWS access key id",
           "gitlab-pat": "GitLab PAT", "private-key": "Private key block",
           "openai-api-key": "OpenAI API key", "slack-webhook-url": "Slack webhook",
           "stripe-access-token": "Stripe secret key", "npm-access-token": "npm token",
           "pypi-upload-token": "PyPI token"}


def _run(cmd: list[str]) -> str | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=900).stdout
    except FileNotFoundError:
        return None
    except Exception:
        return ""


def _engine_findings(engine: str, roots: list[str]) -> list[dict] | None:
    """Findings from an external scanner over `roots`, masked to metadata. Returns None if
    the tool isn't on PATH (caller falls back to the built-in scan)."""
    roots = [r for r in roots if os.path.exists(r)]
    if engine == "trufflehog":
        if not shutil.which("trufflehog"):
            return None
        out = _run(["trufflehog", "filesystem", *roots, "--json", "--no-update"])
        if out is None:
            return None
        found = []
        for line in out.splitlines():
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if not isinstance(o, dict) or "DetectorName" not in o:
                continue
            data = (o.get("SourceMetadata") or {}).get("Data") or {}
            src = data.get("Filesystem") or data.get("Git") or {}
            path = src.get("file") or ""
            det = o.get("DetectorName", "secret")
            found.append({"path": path or "(unknown)", "secret_types": [_TH_MAP.get(det, det)],
                          "masked": mask(o.get("Raw") or o.get("RawV2") or ""),
                          "line": int(src.get("line", 0) or 0),
                          "world_readable": world_readable(path) if path else False,
                          "verified": bool(o.get("Verified")), "source": "trufflehog"})
        return found
    if engine == "gitleaks":
        if not shutil.which("gitleaks"):
            return None
        found = []
        for r in roots:
            out = _run(["gitleaks", "detect", "--no-git", "-s", r, "-f", "json", "-r", "/dev/stdout"])
            if out is None:
                return None
            try:
                arr = json.loads(out) if out.strip() else []
            except ValueError:
                arr = []
            for o in arr if isinstance(arr, list) else []:
                path, rule = o.get("File") or "", o.get("RuleID") or "secret"
                found.append({"path": path or "(unknown)", "secret_types": [_GL_MAP.get(rule, rule)],
                              "masked": mask(o.get("Secret") or o.get("Match") or ""),
                              "line": int(o.get("StartLine", 0) or 0),
                              "world_readable": world_readable(path) if path else False,
                              "verified": False, "source": "gitleaks"})
        return found
    return None


def main() -> int:
    args = sys.argv[1:]
    dry = "--dry-run" in args
    extra_roots = [args[i + 1] for i, a in enumerate(args) if a == "--root" and i + 1 < len(args)]
    engine = next((args[i + 1].strip().lower() for i, a in enumerate(args)
                   if a == "--engine" and i + 1 < len(args)), "")

    findings = None
    if engine:
        roots = [os.path.expanduser(r) for r in _sweep_roots(extra_roots)]
        findings = _engine_findings(engine, roots)
        if findings is None:
            print(f"'{engine}' not found on PATH — falling back to the built-in scan.",
                  file=sys.stderr)
    if findings is None:
        findings = [f for f in (scan_file(p) for p in iter_target_files(extra_roots)) if f]

    if not findings:
        print("✓ No credentials found at rest in the scanned locations.")
        return 0

    print(f"Found {len(findings)} file(s) with credentials at rest:")
    for f in findings:
        perm = "  [world/group-readable]" if f.get("world_readable") else ""
        vtag = "  VERIFIED-LIVE" if f.get("verified") else ""
        src = f"  via {f['source']}" if f.get("source") and f["source"] != "warden" else ""
        print(f"  • {f['path']}:{f['line']}  {', '.join(f['secret_types'])}  ({f['masked']}){perm}{vtag}{src}")

    if dry:
        print("\n(--dry-run: nothing sent to Warden)")
        return 0

    cfg = read_config()
    if not cfg["url"] or not cfg["token"]:
        print("\nNot connected to Warden (set WARDEN_URL/WARDEN_TOKEN or run warden-connect); "
              "findings not reported.", file=sys.stderr)
        return 0
    host = os.getenv("WARDEN_HOST") or os.uname().nodename
    resp = post_batch(cfg, findings, host)
    if resp:
        print(f"\nReported to Warden: {resp.get('flagged', 0)} flagged of "
              f"{resp.get('scanned', 0)} scanned. Review + rotate in the console.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # never disrupt the user
