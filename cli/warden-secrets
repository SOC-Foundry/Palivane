#!/usr/bin/env python3
"""warden-secrets — endpoint credential-hygiene scan (secrets at rest).

Infostealers harvest credentials that are already sitting on the machine — SSH/RSA keys,
`~/.aws/credentials`, `.git-credentials`, `.env` files, CI tokens in shell history. This
scanner finds them *before* a stealer does and reports them to Warden as
`credential_at_rest` findings.

Privacy by design — detection runs **locally** and only METADATA leaves the box: the
secret *type*, file path, line, a masked preview (`ghp_••••4f2a`), and whether the file is
world/group-readable. The raw secret never leaves the device, so Warden never becomes the
exfil path. Reports to POST /api/scan/secrets.

    warden-secrets                 # scan well-known locations + dev roots, report to Warden
    warden-secrets --dry-run       # print what would be reported; send nothing
    warden-secrets --root ~/work   # add an extra directory to the .env sweep

Config: WARDEN_URL + WARDEN_TOKEN (an ak_… key) from the environment, else the gateway
pair in ~/.claude/settings.json / ~/.cursor/warden.json. Stdlib only.
"""

from __future__ import annotations

import json
import os
import re
import stat
import sys
import urllib.request

# --- Secret patterns (mirrors backend patterns.py labels so the server scores by type) ---
_PATTERNS = [
    ("Private key block", re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")),
    ("AWS access key id", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("GitHub token", re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}")),
    ("GitHub fine-grained PAT", re.compile(r"github_pat_[A-Za-z0-9_]{22,}")),
    ("GitLab PAT", re.compile(r"glpat-[A-Za-z0-9_\-]{20,}")),
    ("Slack token", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("Google API key", re.compile(r"AIza[0-9A-Za-z_\-]{30,}")),
    ("Google OAuth token", re.compile(r"ya29\.[0-9A-Za-z_\-]{20,}")),
    ("OpenAI API key", re.compile(r"sk-[a-zA-Z0-9]{16,}")),
    ("Anthropic API key", re.compile(r"sk-ant-[a-zA-Z0-9_\-]{16,}")),
    ("Stripe secret key", re.compile(r"\b[rs]k_(live|test)_[0-9a-zA-Z]{16,}")),
    ("npm token", re.compile(r"npm_[A-Za-z0-9]{36}")),
    ("PyPI token", re.compile(r"pypi-[A-Za-z0-9_\-]{16,}")),
    ("Slack webhook", re.compile(r"https://hooks\.slack\.com/services/[A-Za-z0-9/]{20,}")),
]
# Only trust a generic key=value credential in files that are meant to hold config/secrets.
_ASSIGN_RE = re.compile(
    r"""(?i)\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|
        private[_-]?key|client[_-]?secret)\b\s*[:=]\s*['"]?([^\s'"]{8,})""", re.VERBOSE)

# --- Where credentials actually live -----------------------------------------------------
# Well-known credential files (~-relative). Globs allowed.
_TARGET_GLOBS = [
    "~/.ssh/id_*", "~/.ssh/*.pem",
    "~/.aws/credentials",
    "~/.config/gh/hosts.yml", "~/.config/gh/hosts.yaml",
    "~/.git-credentials",
    "~/.npmrc", "~/.pypirc", "~/.netrc",
    "~/.docker/config.json",
    "~/.kube/config",
    "~/.config/gcloud/application_default_credentials.json",
    "~/.bash_history", "~/.zsh_history",
]
# Dev roots swept (bounded) for .env-style files.
_ENV_ROOTS = ["~/src", "~/code", "~/projects", "~/dev", "~/repos", "~/work", "."]
_PRUNE = {"node_modules", ".git", ".venv", "venv", "dist", "build", "__pycache__", ".next",
          ".cache", "target", "vendor"}
_MAX_BYTES = 1_000_000       # skip files bigger than 1 MB (not credential stores)
_MAX_DEPTH = 4
_PRIVKEY_NAMES = ("id_rsa", "id_ed25519", "id_ecdsa", "id_dsa")


def mask(secret: str) -> str:
    s = secret.strip()
    if len(s) <= 8:
        return "••••"
    return f"{s[:4]}••••{s[-4:]}"


def scan_text(text: str) -> list[tuple[str, int, str]]:
    """Return (secret_type, line_no, masked_preview) for each credential in `text`."""
    found: list[tuple[str, int, str]] = []
    seen: set[tuple[str, str]] = set()
    for lineno, line in enumerate(text.splitlines(), 1):
        if len(line) > 4000:
            line = line[:4000]
        for label, rx in _PATTERNS:
            m = rx.search(line)
            if m and (label, m.group(0)) not in seen:
                seen.add((label, m.group(0)))
                found.append((label, lineno, mask(m.group(0))))
        am = _ASSIGN_RE.search(line)
        if am and ("Credential assignment", am.group(1)) not in seen:
            seen.add(("Credential assignment", am.group(1)))
            found.append(("Credential assignment", lineno, mask(am.group(1))))
    return found


def world_readable(path: str) -> bool:
    try:
        return bool(os.stat(path).st_mode & (stat.S_IRGRP | stat.S_IROTH))
    except OSError:
        return False


def _read(path: str) -> str | None:
    try:
        if os.path.getsize(path) > _MAX_BYTES:
            return None
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read()
    except (OSError, ValueError):
        return None


def scan_file(path: str) -> dict | None:
    """Scan one file; return a report dict (metadata only) or None if clean/unreadable."""
    text = _read(path)
    if text is None:
        return None
    hits = scan_text(text)
    # A private-key *file* by name is a finding even if the header regex is oddly formatted.
    base = os.path.basename(path)
    if not hits and base in _PRIVKEY_NAMES and "PRIVATE KEY" in text:
        hits = [("Private key block", 1, "••••")]
    if not hits:
        return None
    types = list(dict.fromkeys(t for t, _, _ in hits))
    first = hits[0]
    return {"path": path, "secret_types": types, "masked": first[2], "line": first[1],
            "world_readable": world_readable(path)}


def iter_target_files(extra_roots: list[str]) -> list[str]:
    """All candidate files: well-known credential paths + a bounded .env sweep of dev roots."""
    import glob
    paths: list[str] = []
    for g in _TARGET_GLOBS:
        paths.extend(glob.glob(os.path.expanduser(g)))
    for root in _ENV_ROOTS + extra_roots:
        base = os.path.expanduser(root)
        if not os.path.isdir(base):
            continue
        base_depth = base.rstrip(os.sep).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(base):
            if dirpath.count(os.sep) - base_depth >= _MAX_DEPTH:
                dirnames[:] = []
            dirnames[:] = [d for d in dirnames if d not in _PRUNE and not d.startswith(".")
                           or d == ".config"]
            for fn in filenames:
                if fn == ".env" or fn.startswith(".env.") or fn.endswith(".env"):
                    paths.append(os.path.join(dirpath, fn))
    # De-dup, keep only regular files.
    seen, out = set(), []
    for p in paths:
        rp = os.path.realpath(p)
        if rp not in seen and os.path.isfile(p):
            seen.add(rp)
            out.append(p)
    return out


def _settings_env(path: str) -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            data = json.load(f)
        env = data.get("env") if isinstance(data, dict) else None
        return env if isinstance(env, dict) else (data if isinstance(data, dict) else {})
    except Exception:
        return {}


def read_config() -> dict:
    url = os.getenv("WARDEN_URL", "")
    token = os.getenv("WARDEN_TOKEN", "")
    if not url or not token:
        claude = _settings_env("~/.claude/settings.json")
        cursor = _settings_env("~/.cursor/warden.json")
        token = token or claude.get("WARDEN_TOKEN", "") or cursor.get("token", "")
        if not token:
            gw = claude.get("ANTHROPIC_AUTH_TOKEN", "")
            if isinstance(gw, str) and gw.startswith("ak_"):
                token = gw
        if not url:
            url = claude.get("WARDEN_URL", "") or cursor.get("url", "")
            if not url:
                base = claude.get("ANTHROPIC_BASE_URL", "")
                if isinstance(base, str) and base:
                    url = base[:-3] if base.rstrip("/").endswith("/v1") else base
    return {"url": url.rstrip("/"), "token": token}


def post_batch(cfg: dict, items: list[dict], host: str, timeout: float = 15.0) -> dict | None:
    try:
        req = urllib.request.Request(
            cfg["url"] + "/api/scan/secrets", method="POST",
            data=json.dumps({"items": items, "host": host, "record": True}).encode(),
            headers={"content-type": "application/json", "X-Warden-Token": cfg["token"]})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception as e:
        print(f"  (report failed: {e})", file=sys.stderr)
        return None


def main() -> int:
    args = sys.argv[1:]
    dry = "--dry-run" in args
    extra_roots = [args[i + 1] for i, a in enumerate(args) if a == "--root" and i + 1 < len(args)]

    findings = [f for f in (scan_file(p) for p in iter_target_files(extra_roots)) if f]

    if not findings:
        print("✓ No credentials found at rest in the scanned locations.")
        return 0

    print(f"Found {len(findings)} file(s) with credentials at rest:")
    for f in findings:
        perm = "  [world/group-readable]" if f["world_readable"] else ""
        print(f"  • {f['path']}:{f['line']}  {', '.join(f['secret_types'])}  ({f['masked']}){perm}")

    if dry:
        print("\n(--dry-run: nothing sent to Warden)")
        return 0

    cfg = read_config()
    if not cfg["url"] or not cfg["token"]:
        print("\nNot connected to Warden (set WARDEN_URL/WARDEN_TOKEN or run warden-connect); "
              "findings not reported.", file=sys.stderr)
        return 0
    host = os.getenv("WARDEN_HOST") or os.uname().nodename
    resp = post_batch(cfg, findings, host)
    if resp:
        print(f"\nReported to Warden: {resp.get('flagged', 0)} flagged of "
              f"{resp.get('scanned', 0)} scanned. Review + rotate in the console.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # never disrupt the user
