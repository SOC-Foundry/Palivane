#!/usr/bin/env bash
# warden-desktop — govern *desktop* AI apps (Claude/ChatGPT desktop, pinned IDE assistants)
# that make their own HTTPS calls and can't use the gateway or the browser extension.
#
# It runs a LOCAL mitmproxy on 127.0.0.1:8081 with Warden's addon, trusts its CA, and
# points the machine's system HTTPS proxy at it — so those apps' traffic is inspected and
# (in enforce mode) blocked before it leaves. Reuses the per-user token that `warden
# connect` already stored, so no separate sign-in.
#
#   warden-desktop install              # desktop apps + CLIs (sudo: CA trust + system proxy)
#   warden-desktop install --cli-only   # CLIs only (Claude Code, Codex, Gemini) — no sudo
#   warden-desktop uninstall            # stop it; remove system proxy, CA trust, CLI shims
#   warden-desktop status
#
# macOS and Linux (GNOME/KDE; other desktops fall back to manual/env-var setup).
# mitmproxy installs as a self-contained binary (no system Python; PEP-668-proof).
# Windows is a separate PowerShell path (see docs).
set -euo pipefail

WARDEN_URL="${WARDEN_URL:-https://warden.tachtech.net}"
PORT="${WARDEN_PROXY_PORT:-8081}"
HOME_DIR="${HOME}"
WDIR="${HOME_DIR}/.warden"
ADDON="${WDIR}/warden_addon.py"
CA="${HOME_DIR}/.mitmproxy/mitmproxy-ca-cert.pem"
SHIM_DIR="${WDIR}/bin"
# mitmproxy is installed here as a self-contained binary (bundles its own Python) so the
# default install needs no system Python and never trips PEP-668. Pin with WARDEN_MITM_VERSION.
MITM_DIR="${WDIR}/mitmproxy"
MITM_FALLBACK_VERSION="12.2.3"   # used only if the latest-version lookup fails
# CLIs captured via a PATH shim — they use their own HTTP client and ignore the OS proxy
# + trust store, so a system proxy alone never sees them. Override with WARDEN_CLI_TOOLS.
CLI_SHIM_TOOLS="${WARDEN_CLI_TOOLS:-claude codex gemini}"
OS="$(uname -s)"

log() { printf '\033[36m[warden-desktop]\033[0m %s\n' "$*"; }
die() { printf '\033[31m[warden-desktop] %s\033[0m\n' "$*" >&2; exit 1; }

# Normalized Linux desktop, e.g. "kde", "gnome". We branch on this rather than on
# `command -v gsettings`: gsettings is often installed on KDE, but KDE ignores the
# org.gnome.system.proxy keys — so trusting its presence sets a proxy nobody reads
# (silent no-op, the worst failure mode for a security control).
linux_de() { printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr '[:upper:]' '[:lower:]'; }

# The env-var method works for CLIs (Claude Code) and most native apps regardless of DE.
proxy_env_note() {
  log "For CLIs/native apps, export in their environment:"
  log "  HTTPS_PROXY=http://127.0.0.1:$PORT   HTTP_PROXY=http://127.0.0.1:$PORT"
}
proxy_manual_note() {
  log "Couldn't auto-set the system proxy for this desktop (${XDG_CURRENT_DESKTOP:-unknown})."
  log "Set your HTTPS proxy to 127.0.0.1:$PORT in your desktop's network settings, or:"
  proxy_env_note
}

read_token() {
  # The per-user token warden-connect wrote into Claude Code's settings. Parsed with sed
  # (not python) so this path carries no Python dependency; the file is small, flat JSON.
  local f="${HOME_DIR}/.claude/settings.json" tok
  [ -f "$f" ] || die "No Warden token found. Run 'warden connect' first, then re-run this."
  tok="$(sed -n 's/.*"WARDEN_TOKEN"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)"
  [ -n "$tok" ] || tok="$(sed -n 's/.*"ANTHROPIC_AUTH_TOKEN"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)"
  printf '%s' "$tok"
}

# Map uname -m to mitmproxy's release arch token (empty = unsupported → caller falls back).
mitm_arch() {
  case "$(uname -m)" in
    x86_64|amd64)  printf 'x86_64' ;;
    aarch64|arm64) [ "$OS" = "Darwin" ] && printf 'arm64' || printf 'aarch64' ;;
  esac
}

# Latest published version (strip the leading v); WARDEN_MITM_VERSION pins it, and a baked
# fallback keeps install working if GitHub is unreachable.
mitm_version() {
  [ -n "${WARDEN_MITM_VERSION:-}" ] && { printf '%s' "$WARDEN_MITM_VERSION"; return; }
  local v
  v="$(curl -fsSL https://api.github.com/repos/mitmproxy/mitmproxy/releases/latest 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([0-9.]*\)".*/\1/p' | head -1)"
  printf '%s' "${v:-$MITM_FALLBACK_VERSION}"
}

# Preferred install: the self-contained release tarball (bundles Python) → no system deps,
# no PEP-668. Lands mitmdump/mitmproxy/mitmweb in $MITM_DIR.
install_mitm_standalone() {
  local arch os ver url tmp
  arch="$(mitm_arch)"; [ -n "$arch" ] || return 1
  case "$OS" in Darwin) os=macos ;; Linux) os=linux ;; *) return 1 ;; esac
  ver="$(mitm_version)"; [ -n "$ver" ] || return 1
  url="https://downloads.mitmproxy.org/${ver}/mitmproxy-${ver}-${os}-${arch}.tar.gz"
  log "downloading mitmproxy ${ver} (${os}-${arch}); no Python required…"
  mkdir -p "$MITM_DIR"; tmp="$(mktemp -d)"
  if curl -fsSL "$url" -o "${tmp}/m.tar.gz" && tar -xzf "${tmp}/m.tar.gz" -C "$MITM_DIR"; then
    rm -rf "$tmp"; [ -x "${MITM_DIR}/mitmdump" ]
  else
    rm -rf "$tmp"; return 1
  fi
}

# Fallback (unusual arch, or downloads.mitmproxy.org blocked): a dedicated venv or pipx —
# both sidestep PEP-668 (never pip --user into system site-packages). Symlinks into $MITM_DIR.
install_mitm_pip() {
  if command -v python3 >/dev/null 2>&1 && python3 -m venv "${MITM_DIR}/venv" >/dev/null 2>&1 \
       && "${MITM_DIR}/venv/bin/pip" install --quiet mitmproxy >/dev/null 2>&1; then
    ln -sf "${MITM_DIR}/venv/bin/mitmdump" "${MITM_DIR}/mitmdump"; return 0
  fi
  if command -v pipx >/dev/null 2>&1 && pipx install mitmproxy >/dev/null 2>&1; then
    local m; m="$(command -v mitmdump || printf '%s' "${HOME_DIR}/.local/bin/mitmdump")"
    mkdir -p "$MITM_DIR"; ln -sf "$m" "${MITM_DIR}/mitmdump"; return 0
  fi
  return 1
}

ensure_mitm() {
  command -v mitmdump >/dev/null 2>&1 && return
  [ -x "${MITM_DIR}/mitmdump" ] && { export PATH="${MITM_DIR}:$PATH"; return; }
  log "installing mitmproxy (self-contained; no system changes)…"
  install_mitm_standalone || install_mitm_pip \
    || die "could not install mitmproxy automatically; install it from https://mitmproxy.org/downloads/ and re-run."
  export PATH="${MITM_DIR}:$PATH"
  command -v mitmdump >/dev/null 2>&1 || die "mitmproxy installed but 'mitmdump' is still not on PATH."
}

fetch_addon() {
  mkdir -p "$WDIR"
  log "fetching capture addon…"
  curl -fsSL "${WARDEN_URL%/}/cli/warden_addon.py" -o "$ADDON" || die "could not download warden_addon.py from $WARDEN_URL"
}

bootstrap_ca() {
  [ -f "$CA" ] && return
  log "generating mitmproxy CA (first run)…"
  ( mitmdump -q --listen-port "$PORT" >/dev/null 2>&1 & echo $! >/tmp/warden-mitm-boot.pid ) || true
  for _ in $(seq 1 20); do [ -f "$CA" ] && break; sleep 0.5; done
  kill "$(cat /tmp/warden-mitm-boot.pid 2>/dev/null)" 2>/dev/null || true
  rm -f /tmp/warden-mitm-boot.pid
  [ -f "$CA" ] || die "mitmproxy CA was not generated at $CA"
}

trust_ca() {
  case "$OS" in
    Darwin)
      log "trusting the CA (sudo; system keychain)…"
      sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$CA" ;;
    Linux)
      log "trusting the CA (sudo; /usr/local/share/ca-certificates)…"
      sudo cp "$CA" /usr/local/share/ca-certificates/warden-mitmproxy.crt
      sudo update-ca-certificates >/dev/null ;;
    *) die "unsupported OS: $OS" ;;
  esac
}

set_proxy() {
  case "$OS" in
    Darwin)
      local svc; svc="$(networksetup -listnetworkserviceorder | awk -F') ' '/\) /{print $2}' | head -1)"
      log "pointing system HTTPS proxy at 127.0.0.1:$PORT (service: $svc)…"
      sudo networksetup -setsecurewebproxy "$svc" 127.0.0.1 "$PORT"
      sudo networksetup -setsecurewebproxystate "$svc" on ;;
    Linux)
      case "$(linux_de)" in
        *gnome*|*unity*|*cinnamon*|*mate*|*budgie*)
          if command -v gsettings >/dev/null 2>&1; then
            log "setting GNOME system proxy…"
            gsettings set org.gnome.system.proxy mode 'manual'
            gsettings set org.gnome.system.proxy.https host '127.0.0.1'
            gsettings set org.gnome.system.proxy.https port "$PORT"
          else
            proxy_manual_note
          fi ;;
        *kde*|*plasma*)
          local kw; kw="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
          if [ -n "$kw" ]; then
            log "setting KDE system proxy (kioslaverc)…"
            "$kw" --file kioslaverc --group "Proxy Settings" --key ProxyType 1
            "$kw" --file kioslaverc --group "Proxy Settings" --key httpsProxy "http://127.0.0.1:$PORT/"
            "$kw" --file kioslaverc --group "Proxy Settings" --key httpProxy  "http://127.0.0.1:$PORT/"
            # Nudge running KIO apps to reload proxy config (best-effort).
            command -v dbus-send >/dev/null 2>&1 && \
              dbus-send --type=signal /KIO/Scheduler org.kde.KIO.Scheduler.reparseSlaveConfiguration string:'' 2>/dev/null || true
            log "KDE proxy set. KIO-aware apps honor it; CLIs/native apps also need the env vars:"
            proxy_env_note
          else
            proxy_manual_note
          fi ;;
        *)
          proxy_manual_note ;;
      esac ;;
  esac
}

start_service() {
  local tok; tok="$1"
  case "$OS" in
    Darwin)
      local plist="${HOME_DIR}/Library/LaunchAgents/net.tachtech.warden-proxy.plist"
      mkdir -p "${HOME_DIR}/Library/LaunchAgents"
      cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>net.tachtech.warden-proxy</string>
  <key>ProgramArguments</key><array>
    <string>$(command -v mitmdump)</string>
    <string>-q</string><string>-s</string><string>${ADDON}</string>
    <string>--listen-port</string><string>${PORT}</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>WARDEN_URL</key><string>${WARDEN_URL}</string>
    <key>WARDEN_TOKEN</key><string>${tok}</string>
    <key>WARDEN_PROXY_ENFORCE</key><string>${WARDEN_PROXY_ENFORCE:-false}</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
</dict></plist>
PLIST
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load "$plist"
      log "launchd service loaded (net.tachtech.warden-proxy)." ;;
    Linux)
      local unit="${HOME_DIR}/.config/systemd/user/warden-proxy.service"
      mkdir -p "${HOME_DIR}/.config/systemd/user"
      cat > "$unit" <<UNIT
[Unit]
Description=Warden desktop egress proxy
[Service]
Environment=WARDEN_URL=${WARDEN_URL}
Environment=WARDEN_TOKEN=${tok}
Environment=WARDEN_PROXY_ENFORCE=${WARDEN_PROXY_ENFORCE:-false}
ExecStart=$(command -v mitmdump) -q -s ${ADDON} --listen-port ${PORT}
Restart=always
[Install]
WantedBy=default.target
UNIT
      systemctl --user daemon-reload
      systemctl --user enable --now warden-proxy.service
      log "systemd --user service started (warden-proxy)." ;;
  esac
}

# Resolve the real executable for a tool, skipping our own shim dir so a shim never
# exec's itself. Prints the path; returns non-zero if not found.
real_bin() {
  local name="$1" p IFS=:
  for p in $PATH; do
    [ "$p" = "$SHIM_DIR" ] && continue
    [ -x "$p/$name" ] && { printf '%s' "$p/$name"; return 0; }
  done
  return 1
}

# CLIs (Claude Code, Codex, Gemini) are Node/own-HTTP-client tools that ignore the OS
# trust store and system proxy — so pushing a system proxy never captures them. Drop a
# PATH shim that sets HTTPS_PROXY + NODE_EXTRA_CA_CERTS *before* the tool starts
# (NODE_EXTRA_CA_CERTS is read once at Node startup, so it must precede launch), then
# exec the real binary. Surgical + reversible (uninstall removes the shims).
wire_cli_capture() {
  mkdir -p "$SHIM_DIR"
  case ":$PATH:" in
    *":$SHIM_DIR:"*) : ;;
    *) log "note: $SHIM_DIR is not on PATH — add it (install.sh does) or the shims won't take effect." ;;
  esac
  local wired="" name real shim
  for name in $CLI_SHIM_TOOLS; do
    real="$(real_bin "$name")" || continue
    shim="$SHIM_DIR/$name"
    cat > "$shim" <<EOF
#!/usr/bin/env bash
# warden-desktop CLI capture shim (auto-generated; 'warden-desktop uninstall' removes it).
export HTTPS_PROXY="http://127.0.0.1:${PORT}"
export HTTP_PROXY="http://127.0.0.1:${PORT}"
export NODE_EXTRA_CA_CERTS="${CA}"
exec "${real}" "\$@"
EOF
    chmod +x "$shim"
    wired="$wired $name"
  done
  if [ -n "$wired" ]; then
    log "CLI capture wired:$wired (shims in $SHIM_DIR -> 127.0.0.1:$PORT)."
    log "Open a NEW terminal for the shims to take effect."
  else
    log "no target CLIs found on PATH to wire (looked for: $CLI_SHIM_TOOLS)."
  fi
}

unwire_cli_capture() {
  [ -d "$SHIM_DIR" ] || return 0
  local name shim removed=""
  for name in $CLI_SHIM_TOOLS; do
    shim="$SHIM_DIR/$name"
    if [ -f "$shim" ] && grep -q "warden-desktop CLI capture shim" "$shim" 2>/dev/null; then
      rm -f "$shim"; removed="$removed $name"
    fi
  done
  [ -n "$removed" ] && log "removed CLI capture shims:$removed" || true
}

cmd_install() {
  local cli_only=0 a
  for a in "$@"; do [ "$a" = "--cli-only" ] && cli_only=1; done
  command -v curl >/dev/null 2>&1 || die "curl is required."
  local tok; tok="$(read_token)"; [ -n "$tok" ] || die "empty Warden token; run 'warden connect' first."
  ensure_mitm
  fetch_addon
  bootstrap_ca          # generates the CA (also the one NODE_EXTRA_CA_CERTS points at)
  if [ "$cli_only" = "1" ]; then
    log "CLI-only mode: skipping system CA trust + system proxy (no sudo)."
  else
    trust_ca
  fi
  start_service "$tok"
  [ "$cli_only" = "1" ] || set_proxy
  wire_cli_capture      # PATH shims for Node CLIs (needed in both modes — Node ignores the OS proxy/trust)
  if [ "$cli_only" = "1" ]; then
    log "done. CLIs (${CLI_SHIM_TOOLS}) now route through Warden. Enforce mode: ${WARDEN_PROXY_ENFORCE:-false} (monitor)."
    log "Verify: open a NEW terminal and run 'claude'; check findings in the console."
  else
    log "done. Desktop AI apps + CLIs now route through Warden. Enforce mode: ${WARDEN_PROXY_ENFORCE:-false} (monitor)."
    log "Verify: open the Claude/ChatGPT desktop app (or a new terminal for CLIs) and check the console."
  fi
}

cmd_uninstall() {
  unwire_cli_capture
  case "$OS" in
    Darwin)
      local svc; svc="$(networksetup -listnetworkserviceorder | awk -F') ' '/\) /{print $2}' | head -1)"
      sudo networksetup -setsecurewebproxystate "$svc" off 2>/dev/null || true
      launchctl unload "${HOME_DIR}/Library/LaunchAgents/net.tachtech.warden-proxy.plist" 2>/dev/null || true
      rm -f "${HOME_DIR}/Library/LaunchAgents/net.tachtech.warden-proxy.plist"
      log "stopped. (CA left in the keychain; remove manually if desired.)" ;;
    Linux)
      systemctl --user disable --now warden-proxy.service 2>/dev/null || true
      case "$(linux_de)" in
        *gnome*|*unity*|*cinnamon*|*mate*|*budgie*)
          command -v gsettings >/dev/null 2>&1 && gsettings set org.gnome.system.proxy mode 'none' || true ;;
        *kde*|*plasma*)
          local kw; kw="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
          [ -n "$kw" ] && "$kw" --file kioslaverc --group "Proxy Settings" --key ProxyType 0 || true
          command -v dbus-send >/dev/null 2>&1 && \
            dbus-send --type=signal /KIO/Scheduler org.kde.KIO.Scheduler.reparseSlaveConfiguration string:'' 2>/dev/null || true ;;
      esac
      log "stopped. (CA left in the trust store; remove /usr/local/share/ca-certificates/warden-mitmproxy.crt to fully revert.)"
      log "         (If you set HTTPS_PROXY/HTTP_PROXY env vars manually, unset them too.)" ;;
  esac
}

cmd_status() {
  case "$OS" in
    Darwin) launchctl list 2>/dev/null | grep -q warden-proxy && echo "proxy: running" || echo "proxy: not running" ;;
    Linux)  printf 'proxy: %s\n' "$(systemctl --user is-active warden-proxy.service 2>/dev/null || echo 'not running')" ;;
  esac
  local name active=""
  for name in $CLI_SHIM_TOOLS; do
    [ -f "$SHIM_DIR/$name" ] && grep -q "warden-desktop CLI capture shim" "$SHIM_DIR/$name" 2>/dev/null && active="$active $name"
  done
  [ -n "$active" ] && echo "cli shims:$active" || echo "cli shims: none"
}

case "${1:-install}" in
  install)   shift 2>/dev/null || true; cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  status)    cmd_status ;;
  *) die "usage: warden-desktop [install [--cli-only]|uninstall|status]" ;;
esac
