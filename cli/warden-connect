#!/usr/bin/env python3
"""warden connect — self-serve Claude Code onboarding.

Signs the user in to their Warden console (login or SSO) in the browser and configures
Claude Code to route through the Warden gateway — no admin token distribution. Equivalent
of the browser-extension sign-in, for the terminal.

Flow: starts a loopback server, opens <console>/extension-connect pointed at it, the
console mints a per-user tenant-scoped token after auth and redirects it back, then this
writes ~/.claude/settings.json (ANTHROPIC_BASE_URL -> the Warden gateway, ANTHROPIC_AUTH_TOKEN
-> the token). Also wires the local planes when their sibling scripts are available:
WARDEN_URL/WARDEN_TOKEN in the same env block, a PreToolUse hook (warden-hook — local
pre-execution tool-call inspection) and a SessionStart hook (warden-posture — device
posture on session start). If Cursor is installed (~/.cursor present), it also registers
warden-cursor-hook in ~/.cursor/hooks.json and writes ~/.cursor/warden.json — covering
Cursor's prompts + tool calls locally despite its cert pinning. Stdlib only.

    warden-connect                              # hosted SaaS (warden.tachtech.net)
    warden-connect https://warden.self-hosted   # or set WARDEN_URL, for self-hosting
"""

from __future__ import annotations

import http.server
import json
import os
import secrets
import shutil
import socketserver
import sys
import urllib.parse
import webbrowser


# Hosted Warden SaaS default: every org shares this URL (the tenant is resolved by who
# signs in), so `warden connect` alone just works. Override with an arg or WARDEN_URL for
# a self-hosted deployment.
DEFAULT_URL = "https://warden.tachtech.net"


def _console_url(argv) -> str:
    url = (argv[1] if len(argv) > 1 else os.environ.get("WARDEN_URL", "")).strip()
    if not url:
        url = DEFAULT_URL
    if not url.startswith(("http://", "https://")):
        url = "https://" + url
    return url.rstrip("/")


def _capture_token(console: str) -> dict:
    state = secrets.token_urlsafe(9)
    got: dict = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/cb":
                self.send_response(404); self.end_headers(); return
            q = urllib.parse.parse_qs(parsed.query)
            got.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header("content-type", "text/html")
            self.end_headers()
            self.wfile.write(b"<h2>Warden connected. You can close this tab and return to the terminal.</h2>")

        def log_message(self, *a):  # silence
            pass

    with socketserver.TCPServer(("127.0.0.1", 0), Handler) as srv:
        port = srv.server_address[1]
        redirect = f"http://127.0.0.1:{port}/cb"
        url = (f"{console}/extension-connect"
               f"?redirect_uri={urllib.parse.quote(redirect, safe='')}&state={state}")
        print("Opening your browser to sign in…")
        print(f"  If it doesn't open, visit:\n  {url}\n")
        try:
            webbrowser.open(url)
        except Exception:
            pass
        srv.handle_request()  # serve exactly the callback

    if got.get("state") != state:
        sys.exit("Sign-in failed: state mismatch (possible tampering).")
    if not got.get("token"):
        sys.exit("Sign-in failed: no token returned.")
    return got


def _resolve_script(name: str) -> str | None:
    """Locate a sibling Warden script: on PATH, else next to this file."""
    found = shutil.which(name)
    if found:
        return found
    sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    return sibling if os.path.exists(sibling) else None


def _merge_hook(data: dict, event: str, command: str, timeout: int | None = None) -> bool:
    """Add a hook entry for `event` unless one already runs the same script
    (idempotent across re-runs; a moved script path is treated as already installed)."""
    script = os.path.basename(command.split()[0])
    hooks = data.setdefault("hooks", {})
    entries = hooks.setdefault(event, [])
    for entry in entries:
        for h in entry.get("hooks", []) if isinstance(entry, dict) else []:
            if isinstance(h, dict) and script in str(h.get("command", "")):
                return False
    hook: dict = {"type": "command", "command": command}
    if timeout is not None:
        hook["timeout"] = timeout
    entries.append({"matcher": "*", "hooks": [hook]})
    return True


def _write_claude_code(token: str, backend: str, user: str,
                       route_gateway: bool = True) -> tuple[str, list[str]]:
    path = os.path.expanduser("~/.claude/settings.json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    data = {}
    if os.path.exists(path):
        try:
            data = json.load(open(path))
        except (ValueError, OSError):
            data = {}
    env = data.setdefault("env", {})
    if route_gateway:
        # No /v1 suffix — the Anthropic SDK appends /v1/messages itself; {backend}/v1
        # would resolve to {backend}/v1/v1/messages and 405.
        env["ANTHROPIC_BASE_URL"] = backend.rstrip("/")
        env["ANTHROPIC_AUTH_TOKEN"] = token
    # Warden's own names — the hook/posture scripts read these; installed even when the
    # gateway routing above is skipped (org has no model key yet), so the local capture
    # planes work either way.
    env["WARDEN_URL"] = backend.rstrip("/")
    env["WARDEN_TOKEN"] = token

    installed: list[str] = []
    hook = _resolve_script("warden-hook")
    if hook:
        if _merge_hook(data, "PreToolUse", hook, timeout=10):
            installed.append("PreToolUse hook (warden-hook — tool-call inspection)")
    else:
        installed.append("warden-hook not found — skipped tool-call inspection hook")
    posture = _resolve_script("warden-posture")
    if posture:
        if _merge_hook(data, "SessionStart", f"{posture} --async --quiet"):
            installed.append("SessionStart hook (warden-posture — device posture)")
    else:
        installed.append("warden-posture not found — skipped posture hook")

    with open(path, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(path, 0o600)
    return path, installed


# Cursor agent-hook events warden-cursor-hook handles (prompt data-loss + tool calls).
_CURSOR_EVENTS = ["beforeSubmitPrompt", "beforeShellExecution", "beforeMCPExecution",
                  "beforeReadFile", "afterFileEdit"]


def _merge_cursor_hook(data: dict, event: str, command: str) -> bool:
    """Add a Cursor hook entry for `event` unless one already runs the same script.
    Cursor's hooks.json uses a flatter entry shape than Claude Code's: {"command": ...}."""
    script = os.path.basename(command.split()[0])
    entries = data.setdefault("hooks", {}).setdefault(event, [])
    for entry in entries:
        if isinstance(entry, dict) and script in str(entry.get("command", "")):
            return False
    entries.append({"command": command})
    return True


def _write_cursor(token: str, backend: str, user: str) -> tuple[str, list[str]] | None:
    """Wire warden-cursor-hook into ~/.cursor/hooks.json + write the creds file it reads.
    Only when Cursor is actually installed (~/.cursor exists) and the hook is available —
    Cursor's chat pins its cert, so this local hook is how Warden sees it."""
    hook = _resolve_script("warden-cursor-hook")
    cdir = os.path.expanduser("~/.cursor")
    if not hook:
        return None
    if not os.path.isdir(cdir):
        return None, ["Cursor not detected (~/.cursor absent) — skipped Cursor hooks"]

    # Cursor doesn't pass env to hook processes, so the hook reads creds from this file.
    wj = os.path.join(cdir, "warden.json")
    with open(wj, "w") as f:
        json.dump({"url": backend.rstrip("/"), "token": token, "user": user}, f, indent=2)
    os.chmod(wj, 0o600)

    hpath = os.path.join(cdir, "hooks.json")
    data = {}
    if os.path.exists(hpath):
        try:
            data = json.load(open(hpath))
        except (ValueError, OSError):
            data = {}
    if not isinstance(data.get("version"), int):
        data["version"] = 1
    added = sum(1 for ev in _CURSOR_EVENTS if _merge_cursor_hook(data, ev, hook))
    with open(hpath, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(hpath, 0o600)
    msg = f"Cursor hooks installed ({added} event{'s' if added != 1 else ''})" if added \
        else "Cursor hooks already present"
    return hpath, [msg]


def _upstream_warning(got: dict, console: str) -> str | None:
    """A 'your org has no provider key yet' note. The console sends upstream=0/1 with the
    token when it knows whether the gateway can forward Claude Code's calls to a real
    model; absent (older console) means unknown — stay quiet. On 0 we SKIP the gateway
    rerouting (Claude Code keeps its own auth/billing) rather than break it with stubs."""
    if got.get("upstream") != "0":
        return None
    return ("⚠ Gateway routing skipped: your org hasn't set a model provider key yet\n"
            "  (routing without one would answer Claude Code with inspection stubs).\n"
            "  Claude Code keeps working with its own account; the local capture planes\n"
            "  (hooks + posture) are active either way.\n"
            f"  To route through the gateway: an admin adds your Anthropic API key at\n"
            f"  {console} under Settings → Gateway upstreams, then re-run warden-connect.")


def main() -> None:
    console = _console_url(sys.argv)
    got = _capture_token(console)
    backend = got.get("backend") or console
    route_gateway = got.get("upstream") != "0"
    path, installed = _write_claude_code(got["token"], backend, got.get("user", ""),
                                         route_gateway=route_gateway)
    who = got.get("user") or "you"
    print(f"✓ Claude Code connected as {who}")
    if route_gateway:
        print(f"  routed through the Warden gateway: {backend.rstrip('/')}/v1")
    for item in installed:
        print(f"  {item}")
    print(f"  wrote {path}")
    warning = _upstream_warning(got, console)
    if warning:
        print(warning)

    cursor = _write_cursor(got["token"], backend, got.get("user", ""))
    if cursor:
        cpath, citems = cursor
        for item in citems:
            print(f"  {item}")
        if cpath:
            print(f"  wrote {cpath}")
    print("  Start (or restart) Claude Code / Cursor to apply.")


if __name__ == "__main__":
    main()
