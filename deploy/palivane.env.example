# /etc/palivane/palivane.env — environment for the Palivane systemd units.
# Copy to /etc/palivane/palivane.env, fill in, and `chmod 600` (it holds secrets).

# --- Core ---
DATABASE_URL=sqlite:////var/lib/palivane/palivane.db
CORS_ORIGINS=https://palivane.internal.example.com
# Serve the built SPA from the same origin as the API (the native installer sets this to
# the installed static dir). Leave unset to run API-only behind a separate web server.
PALIVANE_STATIC_DIR=/opt/palivane/static

# Auth — REQUIRED. Sign JWTs; generate with `openssl rand -hex 32`.
PALIVANE_SECRET_KEY=replace-me-with-a-long-random-secret
AUTH_TOKEN_TTL=43200

# Self-serve org signup. This install is single-org (create the org + admin with
# palivane-admin), so it ships off: with it on, anyone who can reach the console can
# POST /api/auth/signup and become admin of a new org on this database. On SQLite there
# is no row-level security behind the application's tenant filters, and with signup on a
# weak PALIVANE_SECRET_KEY refuses to boot. Set true only for a multi-tenant deployment,
# and put that on Postgres.
PALIVANE_ALLOW_SIGNUP=false

# Optional: Prometheus scrape token. /metrics answers 404 until it is set; scrape with
# `Authorization: Bearer <token>` (or ?token=). Generate with `openssl rand -hex 32`.
# PALIVANE_METRICS_TOKEN=

# Optional: enrich detection with the Claude judge.
# ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_MODEL=claude-opus-4-8


# Shadow-AI allowlist of approved tools/domains.
# SANCTIONED_AI_TOOLS=claude.ai,copilot.microsoft.com

# --- LLM gateway (protect our AI) ---
# Monitor first. Blocking is what gets a security tool removed from a team that did not
# ask for it, and every customer-facing page says Palivane starts by observing — a shipped
# default of `true` contradicted all of them. Turn it on once the findings justify it.
GATEWAY_ENFORCE=false
GATEWAY_BLOCK_SEVERITY=high
# Same choice for the local capture planes (CLI hooks, desktop proxy): the stance a device
# gets when it has no local flag and the org has not set one in Settings. Keep it in step
# with GATEWAY_ENFORCE. Confirmed secret/PII leaks block in either mode.
CLIENT_ENFORCE=false
# Image DLP: OCR images in gateway requests (screenshots carry keys too) and images the
# Slack/Drive/S3 connectors find. Local tesseract, never a cloud vision API. Off by default;
# needs the tesseract binary
# (apt install tesseract-ocr / dnf install tesseract), then true. Each request's OCR is capped
# (4 images, 5 MB / 16 MP each, 5 s per image, 10 s in all); an image not read marks the
# verdict "partly scanned" and is never a reason to block.
PALIVANE_OCR=false
# GATEWAY_ANTHROPIC_KEY=sk-ant-...   # forwards /v1/messages (Claude Code) to Anthropic
# GATEWAY_GEMINI_KEY=...             # forwards /v1beta/models/{model}:generateContent to Gemini (or GEMINI_API_KEY)
# GATEWAY_XAI_KEY=xai-...            # forwards grok-* models (Grok CLI, OpenAI-shaped) to xAI

# --- Shadow-AI capture (extension / proxy) ---
EXTENSION_INGEST_TOKEN=replace-with-a-long-random-string
INGEST_TENANT=acme
