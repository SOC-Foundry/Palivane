# Instanced oneshot: scan one S3 bucket (%i) for secrets/PII at rest + public exposure.
# Enable a schedule per bucket with the companion timer:
#   systemctl enable --now palivane-s3-scan@my-bucket.timer
# For a bucket whose name isn't a valid unit instance (has "/", etc.), escape it:
#   systemctl enable --now "palivane-s3-scan@$(systemd-escape my.bucket).timer"
[Unit]
Description=Palivane S3 secret & PII scan — bucket %i
Documentation=https://palivane.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=palivane
Group=palivane
# PALIVANE_URL + PALIVANE_TOKEN live here. AWS credentials are best provided by the box's
# instance role / attached identity; otherwise add AWS_* (or AWS_PROFILE/AWS_REGION) to
# this env file too. See deploy/palivane.env.example.
EnvironmentFile=/etc/palivane/palivane.env
# palivane-s3-scan installed alongside the other CLIs (curl <console>/cli/palivane-s3-scan).
# --record persists findings; --fail-closed makes an unreachable backend a visible failure.
ExecStart=/opt/palivane/bin/palivane-s3-scan %i --record --fail-closed

# Hardening — read-only host, no home access, private tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
