[Unit]
Description=Warden API (FastAPI/uvicorn)
Documentation=https://github.com/your-org/warden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warden
Group=warden
WorkingDirectory=/opt/warden/backend
EnvironmentFile=/etc/warden/warden.env
ExecStart=/opt/warden/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/warden

[Install]
WantedBy=multi-user.target
