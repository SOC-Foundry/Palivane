# Module C — content bound for external AI tools. label "malicious" = a high-risk data-egress event.
# (Using an unsanctioned tool with no sensitive data is low-risk policy noise, labeled benign.)
{"id": "c01", "surface": "ai_usage", "label": "malicious", "destination": "https://chat.openai.com/", "content": "Can you clean up this customer list and our billing code? john@acme.com, mary@acme.com, sam@acme.com. SSN 123-45-6789. DB creds: password=Pr0dDb!2024. def charge(card): return gateway.run(card)  # internal billing, CONFIDENTIAL", "expect_categories": ["secret_leak", "pii_exposure", "source_code_leak", "unsanctioned_ai"], "note": "secrets + PII + IP to ChatGPT"}
{"id": "c02", "surface": "ai_usage", "label": "malicious", "destination": "gemini.google.com", "content": "Summarize this spreadsheet of employees: SSN 123-45-6789, 444-55-6666, 777-88-9999 with salaries and home addresses.", "expect_categories": ["pii_exposure", "unsanctioned_ai"], "note": "bulk PII to Gemini"}
{"id": "c03", "surface": "ai_usage", "label": "malicious", "destination": "claude.ai", "content": "Here's our prod config, explain what's wrong: AWS key AKIAABCDEFGHIJKLMNOP, secret=wJalrXUtnFEMI/K7MDENG/bPxRfiCY, and the github token ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZ012345.", "expect_categories": ["secret_leak", "unsanctioned_ai"], "note": "cloud + git secrets"}
{"id": "c04", "surface": "ai_usage", "label": "malicious", "destination": "https://www.perplexity.ai/", "content": "Review this module before I commit. It's marked INTERNAL USE ONLY. import billing\nclass PricingEngine: def compute(self, plan): return plan.base * self.margin", "expect_categories": ["source_code_leak", "unsanctioned_ai"], "note": "proprietary source code"}
{"id": "c05", "surface": "ai_usage", "label": "malicious", "destination": "poe.com", "content": "Draft an email to these leads using their details: contacts are a@x.com, b@y.com, c@z.com, d@w.com, and their card on file 4111 1111 1111 1111.", "expect_categories": ["pii_exposure", "unsanctioned_ai"], "note": "contact list + payment card"}
{"id": "c06", "surface": "ai_usage", "label": "benign", "destination": "https://chat.openai.com/", "content": "Can you brainstorm five blog post titles about remote-work productivity?", "note": "unsanctioned tool but no sensitive data -> low-risk policy noise, not an incident"}
{"id": "c07", "surface": "ai_usage", "label": "benign", "destination": "claude.ai", "content": "Explain the difference between TCP and UDP in simple terms.", "note": "benign question to an AI tool"}
{"id": "c08", "surface": "ai_usage", "label": "benign", "destination": "gemini.google.com", "content": "What are some good icebreaker questions for a team offsite?", "note": "benign"}
{"id": "c09", "surface": "ai_usage", "label": "benign", "destination": "", "content": "Rewrite this paragraph to be more concise and friendly: We are writing to inform you that the event has been moved.", "note": "no destination, no sensitive data"}
{"id": "c10", "surface": "ai_usage", "label": "benign", "destination": "https://chat.openai.com/", "content": "Give me a regex that matches US phone numbers, with an explanation.", "note": "asking about PII patterns is not leaking PII"}
