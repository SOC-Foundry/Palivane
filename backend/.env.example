# Copy to .env and fill in. The app runs without an API key (offline detectors only),
# and enriches detection with an LLM judge when a provider key is set.

# LLM judge (optional) — provider-agnostic. JUDGE_PROVIDER=auto picks whichever key is set
# (anthropic > openai > gemini); force one with anthropic|openai|gemini, or none to disable.
# JUDGE_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...      # Claude backend
# OPENAI_API_KEY=sk-...             # GPT backend
# GEMINI_API_KEY=...                # Gemini backend
# JUDGE_MODEL=                      # blank = per-provider default (claude-opus-4-8 / gpt-4o / gemini-2.5-pro)

# DATABASE_URL=sqlite:///./warden.db
# CORS_ORIGINS=http://localhost:5173

# Auth — REQUIRED in production. Signs JWT session tokens; if unset, an insecure dev
# key is used and the API logs a warning at startup. Generate: openssl rand -hex 32
# WARDEN_SECRET_KEY=
# AUTH_TOKEN_TTL=43200
# Brute-force throttle: refuse logins (429) after N failures per email within the window.
# WARDEN_LOGIN_MAX_FAILS=5
# WARDEN_LOGIN_WINDOW=300
# Redact secrets/PII from STORED finding content (detection still runs on raw). Default on.
# WARDEN_REDACT_FINDINGS=true
# Encrypt stored finding content at rest (decrypted on read). Opt-in; needs a durable
# WARDEN_ENCRYPTION_KEY (key loss = unreadable content). Composes with redaction.
# WARDEN_ENCRYPT_FINDINGS=false
# Encrypts per-tenant upstream provider keys at rest. Defaults to deriving from
# WARDEN_SECRET_KEY; set to rotate independently. Generate: openssl rand -hex 32
# WARDEN_ENCRYPTION_KEY=
# Current data-processing-agreement version an org accepts (compliance record; a prior
# acceptance goes stale when this changes). Recorded via POST /api/tenant/dpa.
# WARDEN_DPA_VERSION=1.0
# Bootstrap accounts: python -m app.users create-tenant / create-user
# (or `python -m app.seed` for a demo tenant: admin@demo.local / changeme123).
# SEED_ADMIN_EMAIL=admin@demo.local
# SEED_ADMIN_PASSWORD=changeme123

# --- LLM gateway (protect our AI) ---
# GATEWAY_ENFORCE=true            # block risky prompts inline (else monitor-only)
# GATEWAY_BLOCK_SEVERITY=high
# Even in monitor mode, hard-block a CONFIRMED secret/PII leak (known-format credential or
# PII) heading to an AI tool — near-zero false positives, high cost of a miss. Default on;
# set false to monitor those too. ("block the certain, monitor the fuzzy")
# GATEWAY_ENFORCE_SECRETS=true
# GATEWAY_SCAN_RESPONSES=true     # response-side DLP: scan model output for secrets/PII
# GATEWAY_UPSTREAM_BASE=https://api.openai.com/v1   # OpenAI-compatible upstream
# GATEWAY_UPSTREAM_KEY=sk-...
# GATEWAY_ANTHROPIC_BASE=https://api.anthropic.com  # for /v1/messages (Claude Code)
# GATEWAY_ANTHROPIC_KEY=sk-ant-...
# GATEWAY_GEMINI_BASE=https://generativelanguage.googleapis.com  # for /v1beta/models/{model}:generateContent
# GATEWAY_GEMINI_KEY=...                            # falls back to GEMINI_API_KEY
# GATEWAY_TOOL_SUPPRESS=claude-code:source_code_leak;cursor:source_code_leak
# Default gateway requests/min per tenant (0 = unlimited); a tenant's own rate_limit wins.
# GATEWAY_RATE_LIMIT=0
# Default sensor/ingest requests/min per tenant (capture planes: /api/ingest/*, /api/scan/*),
# counted SEPARATELY from the gateway so agentic tool-call volume can't starve LLM traffic
# (0 = unlimited); a tenant's own ingest_rate_limit wins.
# INGEST_RATE_LIMIT=0

# --- MCP inspection (agentic tool-use, via the egress proxy) ---
# MCP_ENFORCE=false               # block risky MCP tool calls inline (else monitor-only)
# MCP_BLOCK_SEVERITY=high
# MCP_ALLOWED_SERVERS=            # comma-separated approved MCP server hosts (empty = don't flag on server)
# Persist benign MCP tool-call findings (warden-hook/warden-mcp)? Default off — only warn+
# verdicts are stored (most tool calls are benign noise). Set true for full-fidelity audit.
# WARDEN_MCP_PERSIST_BENIGN=false

# --- Supply chain (agentless, CI-shaped) ---
# DEP_DENYLIST=                   # extra known-bad dependency names (merged with built-in)
# DEP_OSV_ENABLED=false          # check pinned deps against OSV.dev for known CVEs (outbound call)
# IDE_EXT_DENYLIST=              # known-bad IDE extension ids (merged with built-in)
# IDE_EXT_ALLOWED=              # approved IDE extension allowlist (empty = allow all)
# If set, /metrics requires this token (Bearer or ?token=); empty = open (scrape privately).
# WARDEN_METRICS_TOKEN=

# Org-specific secret formats — one label=regex per line (merged into detection).
# CUSTOM_SECRET_PATTERNS=Acme token=ACME-[0-9A-Z]{10}

# Org-specific PII / confidential formats — one label=regex per line (customer IDs, MRNs,
# project codenames). Per-tenant override available in Settings.
# CUSTOM_PII_PATTERNS=Customer ID=CUST-[0-9]{6}

# --- Shadow-AI governance (extension / proxy) ---
# EXTENSION_INGEST_TOKEN=a-long-random-string   # token the extension/proxy present
# INGEST_TENANT=demo                            # tenant their findings attribute to
# SANCTIONED_AI_TOOLS=claude.ai,copilot.microsoft.com
