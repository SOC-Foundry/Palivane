# Copy to .env and fill in. The app runs without an API key (offline detectors only),
# and enriches detection with Claude when ANTHROPIC_API_KEY is set.

# ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_MODEL=claude-opus-4-8

# DATABASE_URL=sqlite:///./warden.db
# CORS_ORIGINS=http://localhost:5173

# Auth — REQUIRED in production. Signs JWT session tokens; if unset, an insecure dev
# key is used and the API logs a warning at startup. Generate: openssl rand -hex 32
# WARDEN_SECRET_KEY=
# AUTH_TOKEN_TTL=43200
# Bootstrap accounts: python -m app.users create-tenant / create-user
# (or `python -m app.seed` for a demo tenant: admin@demo.local / changeme123).
# SEED_ADMIN_EMAIL=admin@demo.local
# SEED_ADMIN_PASSWORD=changeme123

# --- LLM gateway (protect our AI) ---
# GATEWAY_ENFORCE=true            # block risky prompts inline (else monitor-only)
# GATEWAY_BLOCK_SEVERITY=high
# GATEWAY_UPSTREAM_BASE=https://api.openai.com/v1   # OpenAI-compatible upstream
# GATEWAY_UPSTREAM_KEY=sk-...
# GATEWAY_ANTHROPIC_BASE=https://api.anthropic.com  # for /v1/messages (Claude Code)
# GATEWAY_ANTHROPIC_KEY=sk-ant-...
# GATEWAY_GEMINI_BASE=https://generativelanguage.googleapis.com  # for /v1beta/models/{model}:generateContent
# GATEWAY_GEMINI_KEY=...                            # falls back to GEMINI_API_KEY
# GATEWAY_TOOL_SUPPRESS=claude-code:source_code_leak;cursor:source_code_leak

# --- Shadow-AI governance (extension / proxy) ---
# EXTENSION_INGEST_TOKEN=a-long-random-string   # token the extension/proxy present
# INGEST_TENANT=demo                            # tenant their findings attribute to
# SANCTIONED_AI_TOOLS=claude.ai,copilot.microsoft.com
